{
  "name": "subagents",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Automatically delegates matching Pi tasks to Markdown-configured subagents.",
  "main": "index.ts",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "format": "bunx prettier --write .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "check": "bun run check:syntax && bun run test && bun run eval:conversation-context",
    "check:syntax": "node --experimental-strip-types --check index.ts agents.ts *.test.ts runtime/*.ts ui/*.ts evals/orchestration/*.ts evals/conversation-context/run.ts",
    "eval": "bun run eval:conversation-context && bun run eval:orchestration",
    "eval:conversation-context": "bun evals/conversation-context/run.ts",
    "eval:orchestration": "bun evals/orchestration/run.ts",
    "eval:orchestration:strict": "bun evals/orchestration/run.ts --strict-soft",
    "eval:list": "bun evals/orchestration/run.ts --list"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.49"
  },
  "peerDependencies": {
    "@mariozechner/pi-agent-core": "*",
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*"
  },
  "devDependencies": {
    "@mariozechner/pi-agent-core": "^0.70.2",
    "@mariozechner/pi-coding-agent": "^0.70.2",
    "@mariozechner/pi-tui": "^0.70.2",
    "@types/node": "^24.3.0",
    "prettier": "^3.6.2",
    "vitest": "^3.2.4"
  }
}
